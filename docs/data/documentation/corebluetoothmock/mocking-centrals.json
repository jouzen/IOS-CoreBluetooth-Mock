{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock"]]},"abstract":[{"type":"text","text":"How to test an app that acts as a Bluetooth LE peripheral."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/corebluetoothmock\/mocking-centrals"]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralManagerFactory","type":"reference"},{"text":" provides two implementations of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralManager","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralManagerNative","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralManagerMock","type":"reference","isActive":true}]}]}]},{"inlineContent":[{"text":"The native implementation proxies all requests to the ","type":"text"},{"inlineContent":[{"type":"text","text":"CoreBluetooth"}],"type":"strong"},{"text":" framework.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the code runs on a simulator (or the ","type":"text"},{"code":"forceMock","type":"codeVoice"},{"text":" parameter was set) a mock manager","type":"text"},{"text":" ","type":"text"},{"text":"is created. Instead of physical devices, it interacts with mock centrals, defined using","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMCentralSpec","type":"reference"},{"text":". The mock central plays the remote device: it scans, connects, subscribes,","type":"text"},{"text":" ","type":"text"},{"text":"reads and writes, and receives notifications.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The Bluetooth adapter is shared with the central role. Use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMCentralManagerMock\/simulateInitialState(_:)","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMCentralManagerMock\/simulatePowerOn()","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMCentralManagerMock\/simulatePowerOff()","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMCentralManagerMock\/simulateAuthorization(_:)","type":"reference"},{"text":" to control it, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMCentralManagerMock\/tearDownSimulation()","type":"reference"},{"text":" to reset the simulation between tests.","type":"text"}],"type":"paragraph"},{"text":"Creating the peripheral manager","anchor":"Creating-the-peripheral-manager","type":"heading","level":3},{"inlineContent":[{"text":"The code under test does not need to know it is mocked:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let manager = CBMPeripheralManagerFactory.instance(delegate: self, queue: nil)"],"type":"codeListing"},{"inlineContent":[{"text":"Services are published using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMMutableService","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMMutableCharacteristic","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMMutableDescriptor","type":"reference"},{"text":", exactly as with the native API.","type":"text"}],"type":"paragraph"},{"name":"Important","content":[{"inlineContent":[{"type":"text","text":"All characteristics must be "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMMutableCharacteristic"},{"type":"text","text":" objects."},{"type":"text","text":" "},{"type":"text","text":"A characteristic created with a value is cached and must be read-only; requests to read it are"},{"type":"text","text":" "},{"type":"text","text":"answered automatically, without calling the delegate."}],"type":"paragraph"}],"type":"aside","style":"important"},{"text":"Defining a mock central","anchor":"Defining-a-mock-central","type":"heading","level":3},{"syntax":"swift","code":["let central = CBMCentralSpec(maximumUpdateValueLength: 20,","                             connectionInterval: 0.045,","                             delegate: self)"],"type":"codeListing"},{"inlineContent":[{"text":"The delegate (","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMCentralSpecDelegate","type":"reference"},{"text":") receives notifications and indications sent using","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralManager\/updateValue(_:for:onSubscribedCentrals:)","type":"reference"},{"text":". The value is truncated","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"maximumUpdateValueLength","type":"codeVoice"},{"text":", and delivered a connection interval later.","type":"text"}],"type":"paragraph"},{"text":"Simulating a central","anchor":"Simulating-a-central","type":"heading","level":3},{"syntax":"swift","code":["\/\/ Scan for the advertising app. Returns the advertisement data, or nil.","let advertisement = central.simulateScan(withServices: [heartRateService])","","\/\/ Connect and discover the published characteristics.","central.simulateConnection()","let characteristics = central.simulateCharacteristicDiscovery(forService: heartRateService)","","\/\/ Subscribe to notifications.","central.simulateSubscription(to: measurement)","","\/\/ Read, write.","central.simulateReadRequest(for: location) { result in ... }","central.simulateWriteRequest(Data([0x01]), for: controlPoint) { result in ... }","central.simulateWriteRequestWithoutResponse(Data([0x01]), for: controlPoint)","","central.simulateDisconnection()"],"type":"codeListing"},{"inlineContent":[{"text":"Requests reach the peripheral manager’s delegate a connection interval later.","type":"text"},{"text":" ","type":"text"},{"text":"The delegate has to respond using ","type":"text"},{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralManager\/respond(to:withResult:)","isActive":true,"type":"reference"},{"text":". The completion","type":"text"},{"text":" ","type":"text"},{"text":"handler of the simulated request is called with the result, or with an error if the central","type":"text"},{"text":" ","type":"text"},{"text":"disconnects or the adapter is turned off before the app responded.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Behavior matching the native API","type":"heading","anchor":"Behavior-matching-the-native-API"},{"items":[{"content":[{"inlineContent":[{"text":"The manager reports ","type":"text"},{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMManagerState\/unknown","isActive":true,"type":"reference"},{"text":" until the delegate is called with the","type":"text"},{"text":" ","type":"text"},{"text":"initial state. When the adapter is turned off, advertising stops, centrals disconnect and","type":"text"},{"text":" ","type":"text"},{"text":"requests that were not responded to fail. The published services stay in the database, so do","type":"text"},{"text":" ","type":"text"},{"text":"not add them again when the adapter is turned back on: the native manager raises an exception","type":"text"},{"text":" ","type":"text"},{"text":"(“Services cannot be added more than once”), and the mock reports an error to the delegate.","type":"text"},{"text":" ","type":"text"},{"text":"Advertising has to be started again.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Calling ","type":"text"},{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralManager\/startAdvertising(_:)","isActive":true,"type":"reference"},{"text":" while advertising reports","type":"text"},{"text":" ","type":"text"},{"code":"alreadyAdvertising","type":"codeVoice"},{"text":" to the delegate.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Notifications are sent through a transmit queue of limited size. When","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralManager\/updateValue(_:for:onSubscribedCentrals:)","isActive":true,"type":"reference"},{"text":" returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", wait for","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralManagerDelegate\/peripheralManagerIsReady(toUpdateSubscribers:)","isActive":true,"type":"reference"},{"text":". The size of the","type":"text"},{"text":" ","type":"text"},{"text":"mock’s queue is ","type":"text"},{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralManagerMock\/transmitQueueSize","isActive":true,"type":"reference"},{"text":"; it defaults to 1, which is what a","type":"text"},{"text":" ","type":"text"},{"text":"native peripheral manager accepted on an iPhone 13 (iOS 26.6) sending to a Mac. Set a larger value","type":"text"},{"text":" ","type":"text"},{"text":"to simulate a controller that buffers more updates.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Read and write requests are checked against the characteristic’s properties and permissions","type":"text"},{"text":" ","type":"text"},{"text":"before the delegate is called.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Limitations","type":"heading","anchor":"Limitations"},{"items":[{"content":[{"inlineContent":[{"text":"Only ","type":"text"},{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMAdvertisementDataLocalNameKey","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMAdvertisementDataServiceUUIDsKey","isActive":true,"type":"reference"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"supported in advertisement data. Other keys are ignored.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Prepared (queued) writes are not simulated: the delegate always receives a single write request.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"L2CAP channels are not implemented. Publishing or unpublishing a channel is reported to the","type":"text"},{"text":" ","type":"text"},{"text":"delegate with ","type":"text"},{"code":"CBError.operationNotSupported","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"identifier":{"url":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/Mocking-centrals","interfaceLanguage":"swift"},"metadata":{"role":"article","modules":[{"name":"CoreBluetoothMock"}],"roleHeading":"Article","title":"Mocking Bluetooth LE Centrals"},"references":{"doc://ios-corebluetooth-mock.CoreBluetoothMock/documentation/CoreBluetoothMock/CBMCentralSpecDelegate":{"title":"CBMCentralSpecDelegate","kind":"symbol","abstract":[{"type":"text","text":"This delegate should implement the behavior of a real Bluetooth LE central device"},{"type":"text","text":" "},{"type":"text","text":"connected to the simulated local peripheral."}],"type":"topic","url":"\/documentation\/corebluetoothmock\/cbmcentralspecdelegate","navigatorTitle":[{"kind":"identifier","text":"CBMCentralSpecDelegate"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CBMCentralSpecDelegate"}],"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMCentralSpecDelegate","role":"symbol"},"doc://ios-corebluetooth-mock.CoreBluetoothMock/documentation/CoreBluetoothMock/CBMAdvertisementDataLocalNameKey":{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMAdvertisementDataLocalNameKey","abstract":[{"type":"text","text":"The local name of a peripheral."}],"kind":"symbol","url":"\/documentation\/corebluetoothmock\/cbmadvertisementdatalocalnamekey","role":"symbol","title":"CBMAdvertise
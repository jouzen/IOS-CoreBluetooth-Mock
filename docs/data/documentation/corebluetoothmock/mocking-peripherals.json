{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock"]]},"abstract":[{"type":"text","text":"How to create mock peripherals to be used in tests."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/corebluetoothmock\/mocking-peripherals"]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMCentralManagerFactory","type":"reference"},{"text":" provides two implementations of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMCentralManager","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMCentralManagerNative","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMCentralManagerMock","type":"reference","isActive":true}]}]}]},{"inlineContent":[{"text":"The native implementation proxies all requests to the ","type":"text"},{"inlineContent":[{"type":"text","text":"CoreBluetooth"}],"type":"strong"},{"text":" framework.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the code runs on a simulator (or the ","type":"text"},{"code":"forceMock","type":"codeVoice"},{"text":" parameter was set) a mock manager","type":"text"},{"text":" ","type":"text"},{"text":"is created. Instead of physical devices, this manager interacts with mock implementations,","type":"text"},{"text":" ","type":"text"},{"text":"defined as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralSpec","type":"reference"},{"text":". Such peripheral specification should emulate the actual","type":"text"},{"text":" ","type":"text"},{"text":"behavior of a real device as close as possible.","type":"text"}],"type":"paragraph"},{"text":"Defining a Mock Peripheral","anchor":"Defining-a-Mock-Peripheral","type":"heading","level":3},{"inlineContent":[{"text":"To create a mock peripheral use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralSpec\/simulatePeripheral(identifier:proximity:)","type":"reference"},{"text":". This method returns a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralSpec\/Builder","type":"reference"},{"text":" instance which can set up advertisements and connection behavior.","type":"text"},{"text":" ","type":"text"},{"text":"Any number of such specifications can be defined.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Sample code:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let blinky = CBMPeripheralSpec","    .simulatePeripheral(proximity: .near)","    .advertising(","        advertisementData: [","            CBMAdvertisementDataLocalNameKey    : \"nRF Blinky\",","            CBMAdvertisementDataServiceUUIDsKey : [CBMUUID.nordicBlinkyService],","            CBMAdvertisementDataIsConnectable   : true as NSNumber","        ],","        withInterval: 0.250)","    .connectable(","        name: \"nRF Blinky\",","        services: [.blinkyService],","        delegate: BlinkyCBMPeripheralSpecDelegate(),","        connectionInterval: 0.045,","        mtu: 23)","    .build()"],"type":"codeListing"},{"inlineContent":[{"text":"Such mock peripherals must be added to the simulation using","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMCentralManagerMock\/simulatePeripherals(_:)","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["CBMCentralManagerMock.simulatePeripherals([blinky])"],"type":"codeListing"},{"inlineContent":[{"text":"From that moment simulated advertising starts and the device can be scanned or retrieved","type":"text"},{"text":" ","type":"text"},{"text":"just like physical devices.","type":"text"}],"type":"paragraph"},{"text":"Advertising","anchor":"Advertising","type":"heading","level":3},{"inlineContent":[{"text":"A mock peripheral may advertise with:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"static data with a fixed advertising interval,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"one-time","type":"text"}],"type":"emphasis"},{"type":"text","text":" advertisements ("},{"type":"codeVoice","code":"interval"},{"type":"text","text":" set to 0),"}]}]}]},{"inlineContent":[{"text":"Both types of advertisements can be delayed using the ","type":"text"},{"code":"delay","type":"codeVoice"},{"text":" parameter.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The initial advertising configuration is set up using","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralSpec\/Builder\/advertising(advertisementData:withInterval:delay:alsoWhenConnected:)","type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which can be called multiple times, if required."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The advertisement data can be changed during the simulation using"},{"type":"text","text":" "},{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralSpec\/simulateAdvertisementChange(_:)","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Connection","anchor":"Connection","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The"},{"type":"text","text":" "},{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralSpec\/Builder\/connectable(name:services:delegate:connectionInterval:supervisionTimeout:mtu:)","type":"reference","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralSpec\/Builder\/connected(name:services:delegate:connectionInterval:supervisionTimeout:mtu:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"methods allows to specify a "},{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralSpecDelegate","type":"reference","isActive":true},{"type":"text","text":". This object defines the behavior of the"},{"type":"text","text":" "},{"type":"text","text":"mock peripheral, how will it respond to Bluetooth LE requests, a hard reset, etc. The implementation"},{"type":"text","text":" "},{"type":"text","text":"should mimic the behavior of the real device as much as possible to make the tests reliable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To test how the app handles connection interruptions, the mock connection can be terminated using"},{"type":"text","text":" "},{"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMPeripheralSpec\/simulateReset()","type":"re
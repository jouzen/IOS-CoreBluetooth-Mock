{"hierarchy":{"paths":[["doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock"]]},"metadata":{"symbolKind":"typealias","navigatorTitle":[{"text":"CBMUUID","kind":"identifier"}],"role":"symbol","modules":[{"name":"CoreBluetoothMock"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"CBMUUID"}],"title":"CBMUUID","roleHeading":"Type Alias","externalID":"s:17CoreBluetoothMock7CBMUUIDa"},"variants":[{"paths":["\/documentation\/corebluetoothmock\/cbmuuid"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMUUID","interfaceLanguage":"swift"},"abstract":[{"text":"A universally unique identifier, as defined by Bluetooth standards.","type":"text"}],"kind":"symbol","seeAlsoSections":[{"title":"Other","anchor":"Other","generated":true,"identifiers":["doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMError","doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMATTError"]}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"CBMUUID"},{"kind":"text","text":" = "},{"kind":"typeIdentifier","text":"CBUUID","preciseIdentifier":"c:objc(cs)CBUUID"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"Instances of the ","type":"text"},{"code":"CBMUUID","type":"codeVoice"},{"text":" class represent the 128-bit universally unique identifiers (UUIDs)","type":"text"},{"text":" ","type":"text"},{"text":"of attributes used in Bluetooth low energy communication, such as a peripheral’s services,","type":"text"},{"text":" ","type":"text"},{"text":"characteristics, and descriptors. This class provides a number of factory methods for dealing","type":"text"},{"text":" ","type":"text"},{"text":"with long UUIDs when developing your app. For example, instead of passing around the string","type":"text"},{"text":" ","type":"text"},{"text":"representation of a 128-bit Bluetooth low energy attribute in your code, you can create a","type":"text"},{"text":" ","type":"text"},{"code":"CBMUUID","type":"codeVoice"},{"text":" object that represents it, and pass that around instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The Bluetooth Special Interest Group (SIG) publishes a list of commonly-used UUIDs,","type":"text"},{"text":" ","type":"text"},{"text":"many of which are 16- or 32-bits for convenience. The ","type":"text"},{"code":"CBMUUID","type":"codeVoice"},{"text":" class provides methods","type":"text"},{"text":" ","type":"text"},{"text":"that automatically transform these predefined shorter UUIDs into their 128-bit equivalent UUIDs.","type":"text"},{"text":" ","type":"text"},{"text":"When you create a CBMUUID object from a predefined 16- or 32-bit UUID, Core Bluetooth","type":"text"},{"text":" ","type":"text"},{"text":"pre-fills the rest of the 128-bit UUID with the Bluetooth base UUID, as defined in the","type":"text"},{"text":" ","type":"text"},{"text":"Bluetooth 4.0 specification, Volume 3, Part F, Section 3.2.1.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to providing methods for creating "},{"code":"CBMUUID","type":"codeVoice"},{"text":" objects, this class defines constants","type":"text"},{"type":"text","text":" "},{"text":"that represent the UUIDs of the Bluetooth-defined characteristic descriptors, as defined in the","type":"text"},{"type":"text","text":" "},{"text":"Bluetooth 4.0 specification, Volume 3, Part G, Section 3.3.3.","type":"text"}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://ios-corebluetooth-mock.CoreBluetoothMock/documentation/CoreBluetoothMock/CBMUUID":{"navigatorTitle":[{"text":"CBMUUID","kind":"identifier"}],"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMUUID","abstract":[{"type":"text","text":"A universally unique identifier, as defined by Bluetooth standards."}],"kind":"symbol","url":"\/documentation\/corebluetoothmock\/cbmuuid","role":"symbol","title":"CBMUUID","type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CBMUUID","kind":"identifier"}]},"doc://ios-corebluetooth-mock.CoreBluetoothMock/documentation/CoreBluetoothMock":{"abstract":[{"text":"Test ","type":"text"},{"inlineContent":[{"text":"CoreBluetooth","type":"text"}],"type":"strong"},{"text":" features in your app using mocks.","type":"text"}],"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock","type":"topic","title":"CoreBluetoothMock","url":"\/documentation\/corebluetoothmock","role":"collection","kind":"symbol"},"doc://ios-corebluetooth-mock.CoreBluetoothMock/documentation/CoreBluetoothMock/CBMError":{"title":"CBMError","kind":"symbol","abstract":[{"text":"An error that Core Bluetooth returns during Bluetooth transactions.","type":"text"}],"type":"topic","url":"\/documentation\/corebluetoothmock\/cbmerror","navigatorTitle":[{"kind":"identifier","text":"CBMError"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"CBMError"}],"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMError","role":"symbol"},"doc://ios-corebluetooth-mock.CoreBluetoothMock/documentation/CoreBluetoothMock/CBMATTError":{"abstract":[{"text":"An error that Core Bluetooth returns while using Attribute Protocol (ATT).","type":"text"}],"type":"topic","url":"\/documentation\/corebluetoothmock\/cbmatterror","kind":"symbol","role":"symbol","title":"CBMATTError","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"CBMATTError"}],"navigatorTitle":[{"kind":"identifier","text":"CBMATTError"}],"identifier":"doc:\/\/ios-corebluetooth-mock.CoreBluetoothMock\/documentation\/CoreBluetoothMock\/CBMATTError"}}}